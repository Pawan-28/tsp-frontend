{
  "framework": "tanstack-start",
  "build": {
    "env": {
      "VITE_API_URL": "https://lavenderblush-butterfly-422992.hostingersite.com"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lavenderblush-butterfly-422992.hostingersite.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
